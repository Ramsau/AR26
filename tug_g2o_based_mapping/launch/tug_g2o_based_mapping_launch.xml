<?xml version="1.0" encoding="UTF-8"?>

<launch>
  <group>
    <set_env name="GZ_SIM_RESOURCE_PATH" value="/opt/ros/$(env ROS_DISTRO)/share" />

    <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
      <arg name="gz_args" value="$(find-pkg-share tug_husky)/world/maze.world -v 4" />
    </include>
  </group>

  <node pkg="ros_gz_bridge" exec="parameter_bridge" output="screen">
    <param name="config_file" value="$(find-pkg-share tug_husky)/config/parameter_bridge.yaml" />
    <param name="use_sim_time" value="true" />
  </node>

  <include file="$(find-pkg-share tug_husky)/launch/spawn_robot_launch.xml" />

  <node pkg="tf2_ros" exec="static_transform_publisher" args="--frame-id map --child-frame-id odom" output="screen">
    <param name="use_sim_time" value="true" />
  </node>

  <node pkg="tug_g2o_based_mapping" exec="tug_g2o_based_mapping" output="screen">
    <param name="use_sim_time" value="true" />
  </node>
</launch>