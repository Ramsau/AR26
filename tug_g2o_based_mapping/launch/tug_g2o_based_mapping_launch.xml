<?xml version="1.0" encoding="UTF-8"?>

<launch>
  <node pkg="tf2_ros" exec="static_transform_publisher" args="--frame-id map --child-frame-id odom" output="screen">
    <param name="use_sim_time" value="true" />
  </node>

  <node pkg="tug_g2o_based_mapping" exec="tug_g2o_based_mapping" output="screen">
    <param name="use_sim_time" value="true" />
  </node>

  <node pkg="rviz2" exec="rviz2" output="screen" args="-d $(find-pkg-share tug_g2o_based_mapping)/rviz/g2o_based_mapping.rviz -t 'G2OBasedMapping'">
    <param name="use_sim_time" value="true" />
  </node>
</launch>