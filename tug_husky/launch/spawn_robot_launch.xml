<?xml version="1.0" encoding="UTF-8"?>

<launch>
  <node pkg="robot_state_publisher" exec="robot_state_publisher" output="screen">
    <param name="robot_description" value="$(command 'cat $(find-pkg-share tug_husky)/urdf/husky.urdf')" />
    <param name="use_sim_time" value="true" />
  </node>

  <node pkg="ros_gz_sim" exec="create" args="-topic /robot_description -z 0.2" output="screen">
    <param name="use_sim_time" value="true" />
  </node>
</launch>